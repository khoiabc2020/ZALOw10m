<Directives xmlns="http://schemas.microsoft.com/netfx/2013/01/metadata">
  <Application>
    <!--
      An Assembly element with Name="*Application*" applies to all assemblies in
      the application package. The asterisks are not wildcards.
    -->
    <Assembly Name="*Application*" Dynamic="Required All" />

    <!-- Add your application specific runtime directives here. -->
    <Type Name="System.Collections.Generic.KeyValuePair{System.UInt32, System.UInt32}" MarshalObject="Required All" />
    <Type Name="System.Collections.Generic.IReadOnlyDictionary{System.UInt32, System.UInt32}" MarshalObject="Required All" />
  </Application>
</Directives>

