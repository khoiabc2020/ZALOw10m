<Page
    x:Class="ZaloUWP.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource ZaloBlueBrush}" Height="56" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Zalo" FontSize="22" FontWeight="Bold" Foreground="White" />
                <TextBlock Text=" Native" FontSize="16" Foreground="#B3D4FF" Margin="6,4,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" Margin="24,28" MaxWidth="360">
                <TextBlock Text="Đăng nhập bằng mã QR" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="Mở Zalo trên điện thoại, chọn Quét mã QR và quét mã bên dưới."
                           FontSize="13" Foreground="#65717D" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,0,0,20" />

                <Border Width="236" Height="236" Background="#F5F7FA" CornerRadius="12"
                        HorizontalAlignment="Center" Margin="0,0,0,16" Padding="8">
                    <Grid>
                        <Image x:Name="QrDisplayImage" Width="220" Height="220" Stretch="Uniform" />
                        <ProgressRing x:Name="QrProgressBar" IsActive="True" Width="40" Height="40"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock x:Name="QrStatusText" Text="Đang tạo mã QR..." TextWrapping="Wrap"
                           TextAlignment="Center" FontSize="14" Foreground="{StaticResource ZaloBlueBrush}"
                           FontWeight="SemiBold" Margin="0,0,0,18" />

                <Button Click="RefreshQr_Click" HorizontalAlignment="Center"
                        Style="{StaticResource ZaloAccentButtonStyle}" Margin="0,0,0,12" UseSystemFocusVisuals="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Làm mới mã QR" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

