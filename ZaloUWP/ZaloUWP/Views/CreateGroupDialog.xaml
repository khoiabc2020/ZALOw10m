<ContentDialog
    x:Class="ZaloUWP.Views.CreateGroupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZaloUWP.Views"
    xmlns:models="using:ZaloUWP.Models"
    Title="Tạo nhóm trò chuyện"
    PrimaryButtonText="Tạo nhóm"
    SecondaryButtonText="Hủy"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    RequestedTheme="Light"
    Background="#FFFFFF"
    Foreground="#17212B">

    <StackPanel Margin="0,12,0,0" Width="300">
        <TextBox x:Name="GroupNameTextBox" PlaceholderText="Đặt tên nhóm..." Margin="0,0,0,10" />
        <TextBlock Text="Chọn bạn bè tham gia nhóm:" FontSize="13" Foreground="#666" Margin="0,0,0,8" />

        <Border Background="#F7F9FC" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="10" Padding="2">
        <ListView x:Name="FriendsListView"
                  SelectionMode="Multiple"
                  Height="200"
                  Background="Transparent"
                  BorderThickness="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                    <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FriendItem">
                    <Grid Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{x:Bind DisplayAvatar}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </Border>
        <TextBlock x:Name="ErrorTextBlock" Text="" FontSize="12" Foreground="#E02020" />
    </StackPanel>
</ContentDialog>

