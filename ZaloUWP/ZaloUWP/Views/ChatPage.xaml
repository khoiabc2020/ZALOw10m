<Page
    x:Class="ZaloUWP.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZaloUWP.Views"
    xmlns:zlite="using:ZaloLite"
    xmlns:converters="using:ZaloUWP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" IsInverted="True" />
        <Style x:Key="FlatIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused" />
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="PointerFocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="ChatRoot" Background="#E4EBF3">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar (50px Android Zalo Blue #0088FF) -->
        <Grid Grid.Row="0" Height="58" Padding="4,0,8,0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2878F0" Offset="0" />
                    <GradientStop Color="#08A9E8" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Button Grid.Column="0" Click="BackButton_Click" Style="{StaticResource FlatIconButtonStyle}" Foreground="White" Width="40" Height="44" UseSystemFocusVisuals="False">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>

            <!-- Recipient Circular Avatar with photo or colored letter initial -->
            <Grid Grid.Column="1" Width="36" Height="36" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse x:Name="RecipientColor" Width="36" Height="36" Fill="#0088FF" />
                <TextBlock x:Name="RecipientInitial" Text="Z" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse x:Name="RecipientImage" Width="36" Height="36" />
            </Grid>

            <!-- Recipient Info -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleTextBlock" Text="Trò chuyện" FontSize="16" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleTextBlock" Text="Đang hoạt động" FontSize="11.5" Foreground="#D6E8FF" />
            </StackPanel>

            <!-- Audio Call Action -->
            <Button x:Name="VoiceCallHeaderButton" Grid.Column="3" Visibility="Collapsed" Click="CallButton_Click" Style="{StaticResource FlatIconButtonStyle}" Width="46" Height="52" UseSystemFocusVisuals="False">
                <!-- The original PNG is 69x48 with transparent margins; scale its canvas proportionally. -->
                <Image Source="ms-appx:///Assets/Icons/Android/Chat/icn_header_voicecall_white.png" Width="44" Height="31" />
            </Button>

            <!-- Video Call Action -->
            <Button x:Name="VideoCallHeaderButton" Grid.Column="4" Visibility="Collapsed" Click="VideoCallButton_Click" Style="{StaticResource FlatIconButtonStyle}" Width="46" Height="52" UseSystemFocusVisuals="False">
                <Image Source="ms-appx:///Assets/Icons/Android/Chat/btn_videocall_white.png" Width="44" Height="31" />
            </Button>

            <Button x:Name="GroupInfoHeaderButton" Grid.Column="3" Click="InfoButton_Click" Background="Transparent" Width="46" Height="52"
                    Style="{StaticResource FlatIconButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="Thông tin nhóm" UseSystemFocusVisuals="False">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="White" />
            </Button>

            <Button x:Name="GroupMoreHeaderButton" Grid.Column="4" Click="GroupMoreHeaderButton_Click" Background="Transparent" Width="46" Height="52"
                    Style="{StaticResource FlatIconButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="Tùy chọn nhóm" UseSystemFocusVisuals="False">
                <Image Source="ms-appx:///Assets/Icons/Android/Chat/icn_header_menu_more_white.png" Width="40" Height="28" />
            </Button>

            <!-- More / Info Action -->
            <Button x:Name="InfoHeaderButton" Grid.Column="5" Click="InfoButton_Click" Style="{StaticResource FlatIconButtonStyle}" Foreground="White" Width="42" Height="52" UseSystemFocusVisuals="False">
                <Image Source="ms-appx:///Assets/Icons/Android/Chat/icn_header_menu_more_white.png" Width="48" Height="34" />
            </Button>
        </Grid>

        <!-- Message List -->
        <StackPanel Grid.Row="1" Background="Transparent">
            <Border x:Name="StrangerBanner" Background="#FFFFFF" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1"
                    Height="54" Visibility="Collapsed" IsTapEnabled="True" Tapped="AddStranger_Tapped">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#64748B" Margin="0,0,8,0" />
                    <TextBlock x:Name="StrangerActionText" Text="Kết bạn" FontSize="16" Foreground="#273444" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Button x:Name="LoadOlderMessagesButton" Click="LoadOlderMessages_Click"
                    Content="Tải tin nhắn cũ hơn" HorizontalAlignment="Center" Margin="0,4"
                    Padding="14,5" Background="White" Foreground="#2878F0" Visibility="Collapsed"  UseSystemFocusVisuals="False" />
            <Border x:Name="GroupPinnedPreviewPanel" Background="#FFFFFF" BorderBrush="#E6EBF0" BorderThickness="0,0,0,1"
                    Padding="10,8" Visibility="Collapsed" IsTapEnabled="True" Tapped="GroupPinnedPreview_Tapped">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#1684D7"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="Tin nhắn đã ghim" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock x:Name="GroupPinnedPreviewText" FontSize="13" Foreground="#273444" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#98A2AE"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>

        <ListView Grid.Row="2"
                  x:Name="MessagesListView"
                  SelectionMode="None"
                  Padding="8,8"
                  Background="#E4EBF3"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollMode="Enabled"
                  ScrollViewer.IsVerticalScrollChainingEnabled="True">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,2" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                    <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel CacheLength="1.0" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="zlite:ZaloChatMessage">
                    <StackPanel>
                        <Border Background="#AAB3BD" CornerRadius="12" Padding="9,3" Margin="0,2,0,6"
                                HorizontalAlignment="Center" Visibility="{x:Bind DateHeaderVisibility}">
                            <TextBlock Text="{x:Bind DateHeaderText, Mode=OneWay}" FontSize="11" Foreground="White" />
                        </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" HorizontalAlignment="Center" MaxWidth="300" Background="#E8EDF2"
                                CornerRadius="12" Padding="10,5" Margin="0,5"
                                Visibility="{x:Bind SystemEventVisibility}">
                            <TextBlock Text="{x:Bind Text}" FontSize="12" Foreground="#687585"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </Border>
                        <Grid Grid.Column="0" Width="27" Height="27" VerticalAlignment="Bottom" Margin="0,0,5,17"
                              Visibility="{x:Bind MessageAvatarVisibility}">
                            <Ellipse Fill="{x:Bind SenderAvatarBrush}" />
                            <TextBlock Text="{x:Bind SenderInitial}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Fill="{x:Bind SenderAvatarImageBrush, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Grid.Column="{x:Bind MessageColumn}" Grid.ColumnSpan="{x:Bind MessageColumnSpan}"
                                    HorizontalAlignment="{x:Bind Align}" MaxWidth="290"
                                    Visibility="{x:Bind RegularMessageVisibility}">
            <Border Background="{x:Bind Bubble}" BorderBrush="{x:Bind BubbleBorderBrush}"
                                    BorderThickness="{x:Bind BubbleBorderThickness}"
                                    CornerRadius="15" Padding="{x:Bind BubblePadding}"
                                    Holding="Message_Holding" RightTapped="Message_RightTapped"
                                    DoubleTapped="Message_DoubleTapped">
                                <StackPanel>
                                    <Border Background="#160078D3" CornerRadius="8" Padding="7,4" Margin="0,0,0,5"
                                            Visibility="{x:Bind QuotedVisibility}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind QuotedSender}" FontSize="11" FontWeight="SemiBold" Foreground="#087DE0" />
                                            <TextBlock Text="{x:Bind QuotedText}" FontSize="12" Foreground="#526171" TextWrapping="Wrap" MaxLines="2" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{x:Bind Sender}" FontSize="12" FontWeight="SemiBold" Foreground="#087DE0"
                                               Visibility="{x:Bind SenderVisibility}" Margin="0,0,0,3" />
                                    <Border MaxWidth="{x:Bind MediaMaxWidth, Mode=OneWay}" MaxHeight="{x:Bind MediaMaxHeight, Mode=OneWay}" CornerRadius="12" Background="#EDF2F7"
                                            Visibility="{x:Bind MediaVisibility, Mode=OneWay}">
                                    <Grid>
                                        <Image Source="{x:Bind MediaImage, Mode=OneWay}" ImageFailed="MessageImage_Failed" ImageOpened="MessageImage_Opened"
                                               Tapped="MessageImage_Tapped" IsTapEnabled="True" Stretch="Uniform" />
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                Background="#B3000000" CornerRadius="4" Padding="6,2"
                                                Visibility="{x:Bind HasHdPhoto, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                            <TextBlock Text="HD" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    </Border>
                                    <Button Content="{x:Bind MediaRetryText}" Click="RetryMessageImage_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" Padding="8,5"
                                            Background="#FFF5F5" Foreground="#B42318" BorderThickness="0" FontSize="12"
                                            Visibility="{x:Bind MediaRetryVisibility, Mode=OneWay}"  UseSystemFocusVisuals="False" />
                                    <!-- Keep native media engines out of the message list until playback is requested. -->
                                    <ContentControl Tag="video" Visibility="{x:Bind VideoPlayerVisibility, Mode=OneWay}">
                                        <Button Click="PlayVideo_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" Background="#F7FAFD" BorderBrush="#DCE5EE" BorderThickness="1"
                                                Padding="12,10" HorizontalContentAlignment="Left" UseSystemFocusVisuals="False">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#087FF5" Margin="0,0,8,0" />
                                                <TextBlock Text="Phát video" FontSize="13" Foreground="#344054" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </ContentControl>
                                    <ContentControl Tag="voice" Visibility="{x:Bind VoicePlayerVisibility, Mode=OneWay}">
                                        <Button Click="PlayVoice_Click" Style="{StaticResource FlatIconButtonStyle}"
                                                Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Phát tin nhắn thoại" UseSystemFocusVisuals="False">
                                            <Border Background="{x:Bind Bubble}" CornerRadius="14" Padding="9,7" BorderBrush="#DDE6EF" BorderThickness="1">
                                                <Grid Width="224" MinHeight="46">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="20" Background="#087FF5" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                                        <StackPanel Orientation="Horizontal" Height="22" VerticalAlignment="Center">
                                                            <Border Width="3" Height="8" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="15" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="11" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="19" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="13" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="7" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="17" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="10" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="20" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="12" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="8" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="16" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="10" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="18" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="7" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                            <Border Width="3" Height="13" CornerRadius="2" Background="#8CA6BC" Margin="1,0" />
                                                        </StackPanel>
                                                        <TextBlock Text="Tin nhắn thoại" FontSize="10.5" Foreground="#778493" Margin="1,1,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </ContentControl>
                                    <Button Click="RetryPlayback_Click" Background="#F7FAFD" BorderBrush="#DCE5EE" BorderThickness="1"
                                            Padding="10,8" HorizontalContentAlignment="Stretch"
                                            Visibility="{x:Bind PlaybackRetryVisibility, Mode=OneWay}" UseSystemFocusVisuals="False">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind PlaybackFailureText, Mode=OneWay}" FontSize="12.5" Foreground="#344054" />
                                            <TextBlock Text="Chạm để thử phát lại" FontSize="11" Foreground="#087FF5" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="FileMessage_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" Background="#F4F8FC" BorderBrush="#DCE5EE" BorderThickness="1" Padding="9,8"
                                            Visibility="{x:Bind HasFile, Converter={StaticResource BoolToVis}, Mode=OneWay}" UseSystemFocusVisuals="False">
                                        <Grid Width="220">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#087FF5" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FileDisplayName}" FontSize="13" Foreground="#17212B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" />
                                            <TextBlock Grid.Column="2" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#68788A" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Click="LinkPreview_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" Background="#FFF" BorderBrush="#E1E7EE" BorderThickness="1"
                                            Padding="5" Margin="0,4,0,2" HorizontalContentAlignment="Stretch"
                                            Visibility="{x:Bind LinkPreviewVisibility, Mode=OneWay}" UseSystemFocusVisuals="False">
                                        <Grid Width="268" MinHeight="72">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{x:Bind LinkPreviewImage, Mode=OneWay}" Width="70" Height="70"
                                                   Stretch="UniformToFill" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1" Margin="8,1,1,1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind LinkPreviewTitle, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="#17212B" TextWrapping="Wrap" MaxLines="2" />
                                                <TextBlock Text="{x:Bind LinkPreviewDescription, Mode=OneWay}" FontSize="11"
                                                           Foreground="#596777" TextWrapping="Wrap" MaxLines="2" />
                                                <TextBlock Text="{x:Bind LinkPreviewUrl, Mode=OneWay}" FontSize="10"
                                                           Foreground="#087FF5" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Click="LocationCard_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" Background="#F7FBFF" BorderBrush="#D5E5F4" BorderThickness="1"
                                            Padding="10,9" Margin="0,4,0,2" HorizontalContentAlignment="Stretch"
                                            Visibility="{x:Bind LocationVisibility, Mode=OneWay}" UseSystemFocusVisuals="False">
                                        <Grid Width="220">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#087FF5" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind LocationLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#17212B" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind LocationCoordinates, Mode=OneWay}" FontSize="11" Foreground="#64748B" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="#68788A" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Click="PollCard_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" Background="#F7FBFF" BorderBrush="#D5E5F4" BorderThickness="1"
                                            Padding="10,9" Margin="0,4,0,2" HorizontalContentAlignment="Stretch"
                                            Visibility="{x:Bind PollVisibility, Mode=OneWay}" UseSystemFocusVisuals="False">
                                        <Grid Width="220">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#087FF5" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind PollQuestion, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#17212B" TextWrapping="Wrap" MaxLines="2" />
                                                <TextBlock Text="Chạm để xem và bình chọn" FontSize="11" Foreground="#64748B" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="#68788A" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Click="ContactCard_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" Background="#FFFFFF" BorderBrush="#DDE5ED" BorderThickness="1"
                                            Padding="9,8" Margin="0,4,0,2" HorizontalContentAlignment="Stretch"
                                            Visibility="{x:Bind ContactCardVisibility, Mode=OneWay}" UseSystemFocusVisuals="False">
                                        <Grid Width="220">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="40" Height="40" Fill="{x:Bind ContactAvatarBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                            <Ellipse Width="40" Height="40" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{x:Bind ContactAvatarImage, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ContactName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#17212B" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Danh thiếp Zalo" FontSize="11" Foreground="#64748B" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="#087FF5" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Image Source="{x:Bind EmoticonImage, Mode=OneWay}" Width="52" Height="52" Stretch="Uniform"
                                           Visibility="{x:Bind EmoticonVisibility, Mode=OneWay}" Margin="2,2" />
                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontSize="{x:Bind MessageFontSize, Mode=OneWay}" Foreground="#17212B" TextWrapping="Wrap"
                                               Visibility="{x:Bind HasText, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                    <StackPanel Visibility="{x:Bind PhonePreviewVisibility, Mode=OneWay}" Margin="0,7,0,2">
                                        <Border Width="300" Background="White" BorderBrush="#D7E0EA" BorderThickness="1" CornerRadius="13">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="108" /><RowDefinition Height="48" /></Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="#1267D8" CornerRadius="12" Padding="14,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Grid Width="40" Height="40" VerticalAlignment="Top">
                                                            <Ellipse Fill="#DCEBFA" />
                                                            <Ellipse><Ellipse.Fill><ImageBrush ImageSource="{x:Bind PhonePreviewAvatar, Mode=OneWay}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Top">
                                                            <TextBlock Text="{x:Bind PhonePreviewName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                                                       Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                            <TextBlock Text="{x:Bind PhonePreviewNumber, Mode=OneWay}" FontSize="12.5" Foreground="#EAF3FF" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Grid Grid.Row="1" Background="White">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Click="PhoneCardAddFriend_Click" Content="{x:Bind PhonePreviewFriendAction, Mode=OneWay}"
                                                            Background="Transparent" Foreground="#263445" BorderThickness="0" FontSize="14" UseSystemFocusVisuals="False" />
                                                    <Border Grid.Column="1" Background="#E5EAF0" />
                                                    <Button Grid.Column="2" Click="PhoneCardMessage_Click" Content="Nhắn tin"
                                                            Background="Transparent" Foreground="#1769C2" BorderThickness="0" FontSize="14" FontWeight="SemiBold" UseSystemFocusVisuals="False" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Button Click="PhoneNumberCopy_Click" Content="Sao chép số điện thoại" Width="300" Height="40" Margin="0,6,0,0"
                                                Background="#B9C2CC" Foreground="White" BorderThickness="0" FontSize="13" Style="{StaticResource ZaloRoundedActionButtonStyle}"
                                                UseSystemFocusVisuals="False" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#E3E8ED" BorderThickness="1" CornerRadius="10" Padding="4,1"
                                    HorizontalAlignment="{x:Bind Align}" Margin="4,-2,4,0"
                                    Visibility="{x:Bind ReactionVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ReactionDisplayIcon, Mode=OneWay}" FontSize="14" />
                            </Border>
                            <TextBlock Text="{x:Bind TimeText}" FontSize="10.5" Foreground="#82909E" Margin="2,3,2,0"
                                       HorizontalAlignment="{x:Bind Align}" />
                            <StackPanel Orientation="Horizontal" Margin="2,1,2,0"
                                        HorizontalAlignment="{x:Bind Align}" Visibility="{x:Bind DeliveryVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind DeliveryText, Mode=OneWay}" FontSize="9.5" Foreground="{x:Bind DeliveryForeground, Mode=OneWay}"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="16" Height="16" Margin="4,0,0,0" Fill="{x:Bind DeliveryAvatarBrush, Mode=OneWay}"
                                         VerticalAlignment="Center" Visibility="{x:Bind DeliveryAvatarVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Bottom Chat Input Bar -->
        <Border x:Name="ComposerBar" Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="5,6">
            <StackPanel>
                <Border x:Name="PickerPanel" Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="0,0,0,1"
                        Height="286" Margin="0,0,0,6" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Padding="6,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                            <Button x:Name="EmojiModeButton" Grid.Column="0" Content="Emoji" Click="EmojiMode_Click" Margin="2,3" Padding="12,2"
                                    Background="#EAF4FF" Foreground="#087FF5" BorderThickness="0" FontWeight="SemiBold"  UseSystemFocusVisuals="False" />
                            <Button x:Name="StickerModeButton" Grid.Column="1" Content="Nhãn dán" Click="StickerMode_Click" Margin="2,3" Padding="12,2"
                                    Background="Transparent" Foreground="#667085" BorderThickness="0"  UseSystemFocusVisuals="False" />
                            <Button x:Name="GifModeButton" Grid.Column="2" Content="GIF" Click="GifMode_Click" Margin="2,3" Padding="12,2"
                                    Background="Transparent" Foreground="#667085" BorderThickness="0"  UseSystemFocusVisuals="False" />
                            <Button x:Name="ZaloEmojiModeButton" Grid.Column="3" Content="Zalo" Click="ZaloEmojiMode_Click" Margin="2,3" Padding="10,2"
                                    Background="Transparent" Foreground="#667085" BorderThickness="0"  UseSystemFocusVisuals="False" />
                            <TextBox x:Name="StickerSearchBox" Grid.Column="4" PlaceholderText="Tìm nhãn dán" Visibility="Collapsed"
                                     Margin="4,2" Padding="8,3" VerticalContentAlignment="Center" KeyDown="StickerSearchBox_KeyDown"
                                     UseSystemFocusVisuals="False" />
                            <Button x:Name="StickerSearchButton" Grid.Column="5" Content="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                    Click="StickerSearchButton_Click" Visibility="Collapsed" Padding="0" Margin="2"  UseSystemFocusVisuals="False" />
                        </Grid>
                        <ScrollViewer x:Name="EmojiCategoryScroll" Grid.Row="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Padding="5,0">
                                <Button Content="☺" Tag="0" Click="EmojiCategory_Click" Width="40" Height="38" Background="#EAF4FF" Foreground="#087FF5" BorderThickness="0" FontSize="20"  UseSystemFocusVisuals="False" />
                                <Button Content="🐾" Tag="1" Click="EmojiCategory_Click" Width="40" Height="38" Background="Transparent" Foreground="#667085" BorderThickness="0" FontSize="19"  UseSystemFocusVisuals="False" />
                                <Button Content="⌂" Tag="2" Click="EmojiCategory_Click" Width="40" Height="38" Background="Transparent" Foreground="#667085" BorderThickness="0" FontSize="22"  UseSystemFocusVisuals="False" />
                                <Button Content="✦" Tag="3" Click="EmojiCategory_Click" Width="40" Height="38" Background="Transparent" Foreground="#667085" BorderThickness="0" FontSize="20"  UseSystemFocusVisuals="False" />
                                <Button Content="✨" Tag="4" Click="EmojiCategory_Click" Width="40" Height="38" Background="Transparent" Foreground="#667085" BorderThickness="0" FontSize="19"  UseSystemFocusVisuals="False" />
                                <Button Content="🍇" Tag="5" Click="EmojiCategory_Click" Width="40" Height="38" Background="Transparent" Foreground="#667085" BorderThickness="0" FontSize="19"  UseSystemFocusVisuals="False" />
                                <Button Content="🎃" Tag="6" Click="EmojiCategory_Click" Width="40" Height="38" Background="Transparent" Foreground="#667085" BorderThickness="0" FontSize="19"  UseSystemFocusVisuals="False" />
                                <Button Content="🇻🇳" Tag="7" Click="EmojiCategory_Click" Width="40" Height="38" Background="Transparent" Foreground="#667085" BorderThickness="0" FontSize="18"  UseSystemFocusVisuals="False" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="2">
                            <GridView x:Name="EmojiGridView" IsItemClickEnabled="True" ItemClick="EmojiGridView_ItemClick"
                                      SelectionMode="None" Padding="2">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Width" Value="48" />
                                        <Setter Property="Height" Value="48" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                                        <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate><Border Width="42" Height="42" CornerRadius="8" Background="Transparent">
                                        <TextBlock Text="{Binding}" FontFamily="Segoe UI Emoji" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border></DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <GridView x:Name="ZaloEmoticonGridView" IsItemClickEnabled="True" ItemClick="ZaloEmoticonGridView_ItemClick"
                                      SelectionMode="None" Padding="2" Visibility="Collapsed">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Width" Value="52" /><Setter Property="Height" Value="52" />
                                        <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                                        <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate><Border Width="46" Height="46" CornerRadius="10" Background="Transparent" Padding="2">
                                        <Image Source="{Binding ImageUri}" Stretch="Uniform" />
                                    </Border></DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <GridView x:Name="LocalGifGridView" IsItemClickEnabled="True" ItemClick="LocalGifGridView_ItemClick"
                                      SelectionMode="None" Padding="2" Visibility="Collapsed">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Width" Value="92" /><Setter Property="Height" Value="82" />
                                        <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                                        <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate><Border Width="84" Height="74" CornerRadius="12" Background="#F4F7FA" Padding="4">
                                        <Image Source="{Binding ImageUri}" Stretch="Uniform" />
                                    </Border></DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <GridView x:Name="StickerGridView" IsItemClickEnabled="True" ItemClick="StickerGridView_ItemClick"
                                      SelectionMode="None" Padding="2" Visibility="Collapsed">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                                        <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" /></ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="76" Height="72" Padding="4" Background="Transparent">
                                            <Image Source="{Binding ImageUrl}" Stretch="Uniform" />
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <TextBlock x:Name="PickerStatusText" Text="Chọn emoji hoặc tìm nhãn dán" FontSize="12"
                                       Foreground="#8492A0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="RecordingStatusPanel" Background="#FFF1F1" CornerRadius="10" Padding="8,4" Margin="2,0,2,6" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Fill="#D92D20" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="RecordingStatusText" Grid.Column="1" Text="Đang mở microphone…" FontSize="12"
                                   Foreground="#B42318" VerticalAlignment="Center" />
                        <Button x:Name="CancelVoiceRecordingButton" Grid.Column="2" Click="CancelVoiceRecording_Click"
                                Style="{StaticResource FlatIconButtonStyle}" Visibility="Collapsed" Padding="8,5" Margin="4,0"
                                AutomationProperties.Name="Hủy ghi âm" UseSystemFocusVisuals="False">
                            <Border Background="#FDE2E2" CornerRadius="14" Padding="10,3">
                                <TextBlock Text="Hủy" FontSize="12" Foreground="#B42318" />
                            </Border>
                        </Button>
                        <Button x:Name="SendVoiceRecordingButton" Grid.Column="3" Click="SendVoiceRecording_Click"
                                Style="{StaticResource FlatIconButtonStyle}" Visibility="Collapsed" Padding="8,5"
                                AutomationProperties.Name="Gửi tin nhắn thoại" UseSystemFocusVisuals="False">
                            <Border Background="#087FF5" CornerRadius="14" Padding="10,3">
                                <TextBlock Text="Gửi" FontSize="12" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                        </Button>
                    </Grid>
                </Border>
                <Border x:Name="ReplyPreviewPanel" Background="#EEF6FF" BorderBrush="#D4E8FF" BorderThickness="2,0,0,0" CornerRadius="10"
                        Padding="8,5" Margin="2,0,2,6" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ReplySenderText" FontSize="11" FontWeight="SemiBold" Foreground="#087DE0" />
                            <TextBlock x:Name="ReplyBodyText" FontSize="12" Foreground="#526171" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="CancelReply_Click" Style="{StaticResource FlatIconButtonStyle}" Background="Transparent" Foreground="#6B7785" Padding="0" Width="30" Height="30" UseSystemFocusVisuals="False">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                        </Button>
                    </Grid>
                </Border>
                <Grid MinHeight="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>

                <!-- Sticker / Smiley Button -->
                <Button Grid.Column="0" Click="StickerToggle_Click" Style="{StaticResource FlatIconButtonStyle}" Foreground="#64748B" Width="40" Height="44" VerticalAlignment="Center" UseSystemFocusVisuals="False" AutomationProperties.Name="Emoji và nhãn dán">
                    <TextBlock Text="&#xE76E;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="#64748B" />
                </Button>

                <!-- Android-style open composer: no outlined capsule around the placeholder. -->
                <TextBox x:Name="MessageInputBox" Grid.Column="1"
                             PlaceholderText="Tin nhắn"
                             BorderThickness="0"
                             BorderBrush="Transparent"
                             Background="Transparent"
                             FontSize="19"
                             Foreground="#111827"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             UseSystemFocusVisuals="False"
                             MinHeight="44"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxHeight="96"
                             Padding="0,8,0,0"
                             Margin="8,0,2,0"
                             TextChanged="MessageInputBox_TextChanged"
                             GotFocus="MessageInputBox_GotFocus"
                             KeyDown="MessageInputBox_KeyDown">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlForeground" Color="#111827" />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#111827" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A929A" />
                    </TextBox.Resources>
                </TextBox>

                <!-- More actions follow Android's ellipsis; file sharing lives in this menu. -->
                <Button x:Name="MoreButton" Grid.Column="2" Style="{StaticResource FlatIconButtonStyle}" Foreground="#737373" Width="38" Height="44" VerticalAlignment="Center" Click="MoreButton_Click" AutomationProperties.Name="Tùy chọn đính kèm" UseSystemFocusVisuals="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="3" Height="3" Fill="#737373" Margin="2,0" />
                        <Ellipse Width="3" Height="3" Fill="#737373" Margin="2,0" />
                        <Ellipse Width="3" Height="3" Fill="#737373" Margin="2,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="PhotoButton" Grid.Column="4" Style="{StaticResource FlatIconButtonStyle}" Foreground="#0786F9" Width="38" Height="44" VerticalAlignment="Center" Click="PhotoButton_Click" AutomationProperties.Name="Chọn ảnh hoặc video" UseSystemFocusVisuals="False">
                    <Image Source="ms-appx:///Assets/Icons/Android/Chat/icn_camera_gallery.png" Width="26" Height="26" />
                </Button>
                <Button x:Name="VoiceButton" Grid.Column="3" Style="{StaticResource FlatIconButtonStyle}" Foreground="#0786F9" Width="38" Height="44" VerticalAlignment="Center"
                        Click="VoiceButton_Click" AutomationProperties.Name="Ghi âm tin nhắn" UseSystemFocusVisuals="False">
                    <Image Source="ms-appx:///Assets/Icons/Android/Chat/ic_fotohavevoice.png" Width="26" Height="26" />
                </Button>
                <Button x:Name="SendButton" Grid.Column="3" Click="SendButton_Click" Style="{StaticResource FlatIconButtonStyle}" Width="38" Height="44" VerticalAlignment="Center" Visibility="Collapsed" UseSystemFocusVisuals="False">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#0786F9">
                        <Image Source="ms-appx:///Assets/Icons/Android/Chat/btn_send_white.png" Width="17" Height="17" Margin="2,0,0,0" />
                    </Border>
                </Button>
                <Button x:Name="FileButton" Visibility="Collapsed" IsTabStop="False" Click="FileButton_Click" AutomationProperties.Name="Gửi tệp"  UseSystemFocusVisuals="False" />
            </Grid>
            </StackPanel>
        </Border>
        <Border x:Name="GroupPostingNotice" Grid.Row="3" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0" Padding="16,14" Visibility="Collapsed" IsTapEnabled="True"
                Tapped="GroupPostingNotice_Tapped">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="14" Background="#E7F4FF"
                        VerticalAlignment="Top" Margin="0,1,0,0">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#1688F8"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="GroupPostingNoticeText" Grid.Column="1" FontSize="14" Foreground="#747B83"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="GroupPostingNoticeAction" Grid.Column="2" Content="Thông tin" Click="GroupPostingNoticeAction_Click"
                        Background="Transparent" Foreground="#1688F8" BorderThickness="0" Padding="8,4"
                        VerticalAlignment="Center" Visibility="Collapsed" UseSystemFocusVisuals="False" />
            </Grid>
        </Border>
    </Grid>
</Page>
