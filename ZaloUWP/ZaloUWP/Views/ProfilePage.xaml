<Page
    x:Class="ZaloUWP.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    RequestedTheme="Light">
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{StaticResource ZaloBlueBrush}" Padding="4,0,16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="BackButton_Click" Style="{StaticResource FlatIconButtonStyle}" Foreground="White" Width="44" Height="44">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <TextBlock Text="Trang cá nhân" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="16">
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="92" Height="92" Margin="0,2,0,12">
                            <Ellipse Fill="{StaticResource ZaloBlueBrush}" />
                            <TextBlock x:Name="ProfileInitial" Text="Z" Foreground="White" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse x:Name="ProfileAvatar" />
                        </Grid>
                        <TextBlock x:Name="ProfileName" Text="Người dùng Zalo" FontSize="21" FontWeight="SemiBold" Foreground="#17212B" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="Thông tin hồ sơ của bạn" FontSize="13" Foreground="#7A8490" Margin="0,4,0,0" />
                        <Button x:Name="ChangeAvatarButton" Content="Đổi ảnh đại diện" Click="ChangeAvatar_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" Background="Transparent" Foreground="{StaticResource ZaloBlueBrush}" Padding="14,6" Margin="0,6,0,0"  UseSystemFocusVisuals="False" />
                        <Button Content="Chỉnh sửa hồ sơ" Click="EditProfile_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" Background="#EAF3FF" Foreground="{StaticResource ZaloBlueBrush}" Padding="16,7" Margin="0,12,0,0"  UseSystemFocusVisuals="False" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16,4">
                    <StackPanel>
                        <Grid MinHeight="58">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Zalo ID" FontSize="14" Foreground="#7A8490" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProfileUid" Grid.Column="1" FontSize="14" Foreground="#17212B" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <Border Height="1" Background="#EEF0F2" />
                        <Grid MinHeight="58">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Số điện thoại" FontSize="14" Foreground="#7A8490" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProfilePhone" Grid.Column="1" FontSize="14" Foreground="#17212B" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <Border Height="1" Background="#EEF0F2" />
                        <Grid MinHeight="58">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Ngày sinh" FontSize="14" Foreground="#7A8490" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProfileDobText" Grid.Column="1" FontSize="14" Foreground="#17212B" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <Border Height="1" Background="#EEF0F2" />
                        <Grid MinHeight="58">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Giới tính" FontSize="14" Foreground="#7A8490" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProfileGenderText" Grid.Column="1" FontSize="14" Foreground="#17212B" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Trạng thái" FontSize="14" FontWeight="SemiBold" Foreground="#17212B" />
                        <TextBlock x:Name="ProfileStatus" Text="Chưa đặt trạng thái" FontSize="13" Foreground="#718096" TextWrapping="Wrap" Margin="0,6,0,10" />
                        <Button Content="Chỉnh sửa trạng thái" Click="EditStatus_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" HorizontalAlignment="Stretch" Background="#EAF3FF" Foreground="{StaticResource ZaloBlueBrush}" Padding="12,8"  UseSystemFocusVisuals="False" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ProfileFeedback" Text="" FontSize="12" Foreground="#718096" TextWrapping="Wrap" Margin="4,12,4,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
