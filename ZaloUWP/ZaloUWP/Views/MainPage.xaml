                <ScrollViewer>
                    <StackPanel Background="#F5F7FA" Padding="0,0,0,12">
                        <Border Background="White" Padding="16,18" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Nhật ký" FontSize="21" FontWeight="Bold" Foreground="#111827" />
                                <TextBlock Text="Cập nhật từ bạn bè và những người bạn theo dõi" FontSize="12.5" Foreground="#748091" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Margin="14,14,14,0" Padding="18,24" BorderBrush="#E6EBF1" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="62" Height="62" Background="#EDF5FF" CornerRadius="31" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="#1684F8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Chưa có bài viết để hiển thị" FontSize="16" FontWeight="SemiBold" Foreground="#17212B" HorizontalAlignment="Center" />
                                <TextBlock Text="Nhật ký cá nhân chưa được kết nối trong phiên bản này. Thêm bạn bè để sẵn sàng theo dõi cập nhật." FontSize="12.5" Foreground="#718096" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,16" />
                                <Button Content="Tìm bạn bè" Click="GoToContacts_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" Background="#087FF5" Foreground="White" Padding="18,8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"  UseSystemFocusVisuals="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== TAB 4: CÁ NHÂN (ME / PROFILE) ==================== -->
            <Grid x:Name="Tab4Content" Visibility="Collapsed">
                <ScrollViewer>
                    <StackPanel Background="#F5F7FA">
                        <StackPanel Background="White" Padding="16,16,16,22">
                            <Button Style="{StaticResource ProfileActionButtonStyle}" Click="Profile_Click"
                                    HorizontalContentAlignment="Center" AutomationProperties.Name="Cập nhật trạng thái" UseSystemFocusVisuals="False">
                                <Border Background="#F8F9FB" BorderBrush="#EEF0F2" BorderThickness="1" CornerRadius="20" Padding="14,7">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#7C8792" Margin="0,0,7,0" />
                                        <TextBlock x:Name="ProfileStatusPreview" Text="Trạng thái..." FontSize="13" Foreground="#616A73"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="230" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button Style="{StaticResource ProfileActionButtonStyle}" Click="Profile_Click"
                                    HorizontalContentAlignment="Center" Margin="0,10,0,0" AutomationProperties.Name="Xem hồ sơ cá nhân" UseSystemFocusVisuals="False">
                                <StackPanel HorizontalAlignment="Center">
                                    <Grid Width="116" Height="116">
                                        <Ellipse x:Name="ProfileAvatarColor" Fill="#1688F8" />
                                        <TextBlock x:Name="ProfileInitial" Text="Z" Foreground="White" FontSize="38" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse x:Name="ProfileAvatarImage" Stroke="White" StrokeThickness="3" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                        <TextBlock x:Name="ProfileNameText" Text="Người dùng Zalo" FontSize="21" Foreground="#202124"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7D858C"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Height="8" Background="#F1F3F5" />
                        <StackPanel Background="White">
                            <Button Style="{StaticResource ProfileActionButtonStyle}" Click="SettingsButton_Click" MinHeight="78" Padding="20,12" UseSystemFocusVisuals="False">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="19" Background="#F2F7FF" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#087FF5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                        <TextBlock Text="zStyle" FontSize="16" Foreground="#202124" />
                                        <TextBlock Text="Hình nền trò chuyện và âm báo" FontSize="12.5" Foreground="#858B91" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Border Height="8" Background="#F1F3F5" />
                        <StackPanel Background="White">
                            <Button Style="{StaticResource ProfileActionButtonStyle}" Click="OpenLocalData_Click" MinHeight="76" Padding="20,12" UseSystemFocusVisuals="False">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="19" Background="#F2F7FF" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#087FF5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                        <TextBlock Text="Dữ liệu trên máy" FontSize="16" Foreground="#202124" />
                                        <TextBlock Text="Quản lý cài đặt và bộ nhớ đệm" FontSize="12.5" Foreground="#858B91" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#F0F1F2" Margin="62,0,0,0" />
                            <Button Style="{StaticResource ProfileActionButtonStyle}" Click="SettingsButton_Click" MinHeight="68" Padding="20,10" UseSystemFocusVisuals="False">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="ms-appx:///Assets/Icons/ic_security_blue.png" Width="22" Height="22" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Tài khoản và bảo mật" FontSize="16" Foreground="#202124" VerticalAlignment="Center" Margin="10,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Border Height="8" Background="#F1F3F5" />
                        <Border Background="White" Padding="18,18,18,20">
                            <Button HorizontalAlignment="Stretch" Height="44" Background="White" Foreground="#D94B4B"
                                    BorderBrush="#F0C8C8" BorderThickness="1" Click="SignOut_Click" UseSystemFocusVisuals="False">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Đăng xuất" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 3. BOTTOM NAVIGATION BAR (Zalo Android 5 Tabs) -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- TAB 0: TIN NHẮN -->
                <Button Grid.Column="0" Style="{StaticResource BottomTabButtonStyle}" Click="TabMessages_Click" UseSystemFocusVisuals="False">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="Tab0Icon" Source="ms-appx:///Assets/Icons/tab_msg_active.png" Width="22" Height="22" HorizontalAlignment="Center" />
                            <TextBlock x:Name="Tab0Text" Text="Tin nhắn" FontSize="10.5" FontWeight="SemiBold" Foreground="#0088FF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                        <!-- Red Notification Badge for Unread Messages -->
                        <Border x:Name="Tab0BadgeBorder" Background="#E53935" CornerRadius="8" MinWidth="16" Height="16" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14,-3,-8,0" Visibility="Collapsed">
                            <TextBlock x:Name="Tab0BadgeText" Text="0" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <!-- TAB 1: DANH BẠ -->
                <Button Grid.Column="1" Style="{StaticResource BottomTabButtonStyle}" Click="TabContacts_Click" UseSystemFocusVisuals="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="Tab1Icon" Source="ms-appx:///Assets/Icons/tab_contact_inactive.png" Width="22" Height="22" HorizontalAlignment="Center" />
                        <TextBlock x:Name="Tab1Text" Text="Danh bạ" FontSize="10.5" FontWeight="Normal" Foreground="#757575" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>

                <!-- TAB 2: KHÁM PHÁ -->
                <Button Grid.Column="2" Style="{StaticResource BottomTabButtonStyle}" Click="TabDiscovery_Click" UseSystemFocusVisuals="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="Tab2Icon" Source="ms-appx:///Assets/Icons/tab_discovery_inactive.png" Width="22" Height="22" HorizontalAlignment="Center" />
                        <TextBlock x:Name="Tab2Text" Text="Khám phá" FontSize="10.5" FontWeight="Normal" Foreground="#757575" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>

                <!-- TAB 3: NHẬT KÝ -->
                <Button Grid.Column="3" Visibility="Collapsed" Style="{StaticResource BottomTabButtonStyle}" Click="TabTimeline_Click" UseSystemFocusVisuals="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="Tab3Icon" Source="ms-appx:///Assets/Icons/tab_timeline_inactive.png" Width="22" Height="22" HorizontalAlignment="Center" />
                        <TextBlock x:Name="Tab3Text" Text="Nhật ký" FontSize="10.5" FontWeight="Normal" Foreground="#757575" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>

                <!-- TAB 4: CÁ NHÂN -->
                <Button Grid.Column="4" Style="{StaticResource BottomTabButtonStyle}" Click="TabMe_Click" UseSystemFocusVisuals="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="Tab4Icon" Source="ms-appx:///Assets/Icons/tab_me_inactive.png" Width="22" Height="22" HorizontalAlignment="Center" />
                        <TextBlock x:Name="Tab4Text" Text="Cá nhân" FontSize="10.5" FontWeight="Normal" Foreground="#757575" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>

