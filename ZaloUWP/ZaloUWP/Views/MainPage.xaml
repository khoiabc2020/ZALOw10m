<Page
    x:Class="ZaloUWP.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZaloUWP.Views"
    xmlns:zlite="using:ZaloLite"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <Style x:Key="BottomTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused" />
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="PointerFocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Remove the square system Button pressed/focus chrome around pill filters. -->
        <Style x:Key="ContactFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Padding" Value="14,13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER (Vibrant Zalo Blue #0088FF) -->
        <Grid Grid.Row="0" Height="56" Padding="10,0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2878F0" Offset="0" />
                    <GradientStop Color="#08A9E8" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search Lens Icon -->
            <Image Grid.Column="0" Source="ms-appx:///Assets/Icons/ic_search_white.png" Width="20" Height="20" Margin="2,0,8,0" VerticalAlignment="Center" />

            <!-- Flat Search Input Bar with "Tìm kiếm" Placeholder -->
            <Border Grid.Column="1" Background="#24FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1"
                    CornerRadius="11" Padding="9,0" VerticalAlignment="Center" Height="36">
                <TextBox x:Name="SearchBox"
                         PlaceholderText="Tìm kiếm"
                         Height="36"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="White"
                         FontSize="15"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Padding="0,8,0,0"
                         UseSystemFocusVisuals="False"
                         RequestedTheme="Dark"
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#22FFFFFF" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#22FFFFFF" />
                        <SolidColorBrush x:Key="TextControlForeground" Color="White" />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="White" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#D9FFFFFF" />
                    </TextBox.Resources>
                </TextBox>
            </Border>

            <!-- QR Scanner Button -->
            <Button x:Name="QrScanHeaderButton" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource FlatIconButtonStyle}" Width="36" Height="36" Click="QrScan_Click" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Icons/ic_qr_white.png" Width="20" Height="20" />
            </Button>

            <!-- Plus Menu Button -->
            <Button x:Name="PlusHeaderButton" Grid.Column="3" Style="{StaticResource FlatIconButtonStyle}" Width="36" Height="36" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Icons/ic_plus_white.png" Width="20" Height="20" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Tạo nhóm mới" Click="CreateGroup_Click" />
                        <MenuFlyoutItem Text="Thêm bạn mới" Click="AddFriend_Click" />
                        <MenuFlyoutItem Text="Làm mới danh sách" Click="RefreshList_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Cài đặt giao diện" Click="SettingsButton_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="ContactGroupsHeaderButton" Grid.Column="2" Style="{StaticResource FlatIconButtonStyle}" Width="36" Height="36"
                    Click="ContactGroupsHeader_Click" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Nhóm">
                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="White" />
            </Button>
            <Button x:Name="ContactRequestsHeaderButton" Grid.Column="3" Style="{StaticResource FlatIconButtonStyle}" Width="36" Height="36"
                    VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Lời mời kết bạn">
                <Image Source="ms-appx:///Assets/Icons/Android/icn_header_addfriend.png" Width="24" Height="24" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Lời mời kết bạn" Click="FriendRequestsMenu_Click" />
                        <MenuFlyoutItem Text="Lời mời đã gửi" Click="SentFriendRequestsMenu_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Thêm bạn mới" Click="AddFriend_Click" />
                        <MenuFlyoutItem Text="Làm mới danh bạ" Click="RefreshContacts_Click" />
                        <MenuFlyoutItem Text="Tạo nhóm chat" Click="CreateGroup_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="ProfileSettingsHeaderButton" Grid.Column="3" Style="{StaticResource FlatIconButtonStyle}" Width="40" Height="40"
                    Click="SettingsButton_Click" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Cài đặt">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="White" />
            </Button>
        </Grid>

        <!-- 2. MAIN CONTENT (5 TABS CONTAINER) -->
        <Grid Grid.Row="1">
            <!-- ==================== TAB 0: TIN NHẮN (CHATS) ==================== -->
            <Grid x:Name="Tab0Content" Visibility="Visible">
                <Grid Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Subtabs Bar: "Ưu tiên" & "Khác" -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Padding="14,0">
                            <!-- Subtab: Ưu tiên -->
                            <Button x:Name="SubTabPriorityBtn" Style="{StaticResource FlatIconButtonStyle}" Margin="0,0,24,0" Click="SubTabPriority_Click" VerticalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Stretch">
                                    <TextBlock x:Name="PriorityTabText" Text="Ưu tiên" FontSize="13.5" FontWeight="SemiBold" Foreground="#111827" Margin="0,7,0,5" />
                                    <Border x:Name="PriorityIndicator" Height="2.5" Width="50" Background="#111827" />
                                </StackPanel>
                            </Button>

                            <!-- Subtab: Khác -->
                            <Button x:Name="SubTabOtherBtn" Style="{StaticResource FlatIconButtonStyle}" Click="SubTabOther_Click" VerticalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Stretch">
                                    <TextBlock x:Name="OtherTabText" Text="Khác" FontSize="13.5" FontWeight="Normal" Foreground="#757575" Margin="0,7,0,5" />
                                    <Border x:Name="OtherIndicator" Height="2.5" Width="36" Background="#111827" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Priority Conversations View -->
                    <Grid Grid.Row="1" x:Name="PriorityGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Phone Sync Banner -->
                        <Border Grid.Row="0" x:Name="SyncBanner" Background="#E8F4FD" BorderBrush="#CCE4F7" BorderThickness="0,0,0,1" Padding="14,10" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0068FF" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="SyncBannerTitle" Text="Đồng bộ tin nhắn từ điện thoại" FontSize="13" FontWeight="SemiBold" Foreground="#0068FF" />
                                    <TextBlock x:Name="SyncBannerSubtitle" Text="Nhấn để tải toàn bộ lịch sử tin nhắn" FontSize="11.5" Foreground="#555555" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="SyncBannerButton" Content="Đồng bộ" Background="#0068FF" Foreground="White" FontSize="12" FontWeight="SemiBold" Padding="10,4" Margin="6,0,0,0" Click="SyncPhone_Click" VerticalAlignment="Center"  UseSystemFocusVisuals="False" />
                            </Grid>
                        </Border>

                        <!-- Conversation List -->
                        <ListView Grid.Row="1"
                                  x:Name="ConversationList"
                                  Background="#FFFFFF"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                  ShowsScrollingPlaceholders="False"
                                  ItemClick="ConversationList_ItemClick">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel CacheLength="1.5" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.Header>
                                <Border x:Name="StrangerInboxHeader" Visibility="Collapsed" Background="#F5F6F7"
                                        BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,12"
                                        Tapped="OpenStrangerInbox_Tapped">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="23" Background="#1688F8"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="Tin nhắn từ người lạ" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="#202124" />
                                            <TextBlock Text="Tin nhắn từ người chưa có trong danh bạ" FontSize="13"
                                                       Foreground="#858A90" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border x:Name="StrangerInboxCountBadge" Grid.Column="2" MinWidth="22" Height="22"
                                                CornerRadius="11" Background="#E8EDF2" VerticalAlignment="Center" Padding="6,0">
                                            <TextBlock x:Name="StrangerInboxCountText" FontSize="11" Foreground="#59636E"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </ListView.Header>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                                    <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="zlite:ZaloConversation">
                                    <Grid Height="78" Padding="14,0" Background="#FFFFFF" Holding="Conversation_Holding" RightTapped="Conversation_RightTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="78" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Conversation avatar; group badge makes the conversation type legible without inventing member photos. -->
                                        <Grid Grid.Column="0" Width="50" Height="50" VerticalAlignment="Center">
                                            <Ellipse Fill="{x:Bind AvatarColor, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Initial, Mode=OneWay}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Fill="{x:Bind AvatarImageBrush, Mode=OneWay}" />
                                            <Border Width="19" Height="19" CornerRadius="10" Background="#EAF3FC" BorderBrush="White" BorderThickness="1.5"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{x:Bind GroupVisibility, Mode=OneWay}">
                                                <TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#3B78B4"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <!-- Middle Info: Title + Last Message -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="18" Height="18" CornerRadius="5" Background="#EEF4FA" Margin="0,0,6,0"
                                                        VerticalAlignment="Center" Visibility="{x:Bind GroupVisibility, Mode=OneWay}">
                                                    <TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#5682A9"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="#202124"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind LastText, Mode=OneWay}" FontSize="14" Foreground="#73777C"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Right side: time and real pin/mute state, then unread badge. -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9AA0A6"
                                                           VerticalAlignment="Center" Margin="0,0,5,0" Visibility="{x:Bind PinnedVisibility, Mode=OneWay}" />
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9AA0A6"
                                                           VerticalAlignment="Center" Margin="0,0,5,0" Visibility="{x:Bind MutedVisibility, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind TimeText, Mode=OneWay}" FontSize="12" Foreground="#858A90" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border Background="#E84B50" CornerRadius="10" MinWidth="19" Height="19" Padding="5,0"
                                                    HorizontalAlignment="Right" Visibility="{x:Bind UnreadVisibility, Mode=OneWay}" Margin="0,7,0,0">
                                                <TextBlock Text="{x:Bind UnreadLabel, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Bottom Separator Divider -->
                                        <Border Grid.ColumnSpan="3" BorderBrush="#EAECEF" BorderThickness="0,0,0,1" Margin="64,0,0,0" VerticalAlignment="Bottom" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty Conversations State -->
                        <StackPanel x:Name="EmptyConversationPanel"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed" Padding="20">
                            <Border Width="60" Height="60" Background="#EFF6FF" CornerRadius="30" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#0088FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="EmptyConversationTitle" Text="Chưa có cuộc trò chuyện nào" FontSize="16" FontWeight="SemiBold" Foreground="#111827" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyConversationDescription" Text="Chọn bạn bè trong Danh bạ để bắt đầu trò chuyện" FontSize="13" Foreground="#757575" HorizontalAlignment="Center" Margin="0,4,0,16" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button x:Name="EmptyConversationContactsButton" Content="Mở Danh bạ bạn bè" Click="GoToContacts_Click"
                                    Background="#0088FF" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                    Padding="18,8" HorizontalAlignment="Center"  UseSystemFocusVisuals="False" />
                            <TextBlock x:Name="ConversationStatusText" Text="" FontSize="11.5" Foreground="#8A8A8A"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="NoConversationSearchPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed" Padding="24" IsHitTestVisible="False">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#AAB4C0" HorizontalAlignment="Center" />
                            <TextBlock Text="Không tìm thấy kết quả" FontSize="15" FontWeight="SemiBold" Foreground="#354052" HorizontalAlignment="Center" Margin="0,10,0,3" />
                            <TextBlock Text="Thử tìm bằng tên liên hệ hoặc nội dung tin nhắn đã tải." FontSize="12.5" Foreground="#7B8794"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="250" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>

            <!-- ==================== TAB 1: DANH BẠ (CONTACTS) ==================== -->
            <Grid x:Name="Tab1Content" Visibility="Collapsed">
                <Grid Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Rounded contact filters, following the Android contact screen -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Padding="14,5">
                            <Button Style="{StaticResource ContactFilterButtonStyle}" Margin="0,0,9,0" Click="SubTabAll_Click" UseSystemFocusVisuals="False">
                                <Border x:Name="AllChip" Background="#E5E7EB" BorderBrush="Transparent" BorderThickness="0" CornerRadius="18" Padding="15,6">
                                    <TextBlock x:Name="AllTabText" Text="Tất cả" FontSize="13.5" FontWeight="SemiBold" Foreground="#111827" />
                                </Border>
                            </Button>
                            <Button Style="{StaticResource ContactFilterButtonStyle}" Margin="0,0,9,0" Click="SubTabFriends_Click" UseSystemFocusVisuals="False">
                                <Border x:Name="FriendsChip" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="18" Padding="15,6">
                                    <TextBlock x:Name="FriendsTabText" Text="Bạn bè" FontSize="13.5" FontWeight="Normal" Foreground="#757575" />
                                </Border>
                            </Button>
                            <Button Style="{StaticResource ContactFilterButtonStyle}" Click="SubTabOA_Click" UseSystemFocusVisuals="False">
                                <Border x:Name="OAChip" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="18" Padding="15,6">
                                    <TextBlock x:Name="OATabText" Text="OA" FontSize="13.5" FontWeight="Normal" Foreground="#757575" />
                                </Border>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Friends Subtab View -->
                    <ListView Grid.Row="1" x:Name="FriendList"
                                      Background="#FFFFFF"
                                      IsItemClickEnabled="True"
                                      SelectionMode="None"
                                      ShowsScrollingPlaceholders="False"
                                      ItemClick="FriendList_ItemClick" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.Header>
                            <StackPanel Background="#FFFFFF">

                            <Border x:Name="FriendRequestsCard" Visibility="Collapsed" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"
                                    Padding="14,12" IsTapEnabled="True" Tapped="FriendRequests_Tapped">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
