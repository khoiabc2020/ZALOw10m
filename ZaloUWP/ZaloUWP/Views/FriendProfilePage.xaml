<Page
    x:Class="ZaloUWP.Views.FriendProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">
    <Grid Background="#F3F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{StaticResource ZaloBlueBrush}" Padding="6,0,14,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="BackButton_Click" Style="{StaticResource FlatIconButtonStyle}" Foreground="White" Width="44" Height="44">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
                </Button>
                <TextBlock Text="Thông tin cá nhân" FontSize="18" FontWeight="SemiBold" Foreground="White"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="14">
                <Grid Height="112" Background="#D7E8FA">
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                    <Rectangle Fill="#26000000" />
                </Grid>
                <Border Background="White" CornerRadius="12" Padding="18,0,18,18" Margin="0,0,0,12">
                    <StackPanel>
                        <Ellipse Width="92" Height="92" HorizontalAlignment="Center" Margin="0,-46,0,10"
                                 Stroke="White" StrokeThickness="4">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="NameText" Text="Zalo" FontSize="22" FontWeight="SemiBold"
                                   Foreground="#17212B" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusText" Text="" FontSize="14" Foreground="#637282"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="OnlineText" Text="" FontSize="12" Foreground="#168A55"
                                   TextAlignment="Center" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16,4">
                    <StackPanel>
                        <Grid MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Zalo ID" FontSize="14" Foreground="#7A8490" VerticalAlignment="Center" />
                            <TextBlock x:Name="UserIdText" Grid.Column="1" FontSize="14" Foreground="#17212B"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <Border Height="1" Background="#EEF0F2" />
                        <Grid x:Name="PhoneRow" MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Điện thoại" FontSize="14" Foreground="#7A8490" VerticalAlignment="Center" />
                            <TextBlock x:Name="PhoneText" Grid.Column="1" FontSize="14" Foreground="#17212B"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <Border x:Name="BirthdayDivider" Height="1" Background="#EEF0F2" />
                        <Grid x:Name="BirthdayRow" MinHeight="54">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Ngày sinh" FontSize="14" Foreground="#7A8490" VerticalAlignment="Center" />
                            <TextBlock x:Name="BirthdayText" Grid.Column="1" FontSize="14" Foreground="#17212B"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <Button Click="LoadMutualGroups_Click" Background="Transparent" BorderThickness="0" Padding="2,6" HorizontalContentAlignment="Stretch" UseSystemFocusVisuals="False">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#1684D7" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Xem nh&#xF3;m chung" FontSize="16" Foreground="#17212B" />
                                    <TextBlock x:Name="MutualGroupsStatus" Text="Ch&#x1EA1;m &#x111;&#x1EC3; ki&#x1EC3;m tra nh&#xF3;m c&#xF9;ng tham gia" FontSize="12" Foreground="#7A8490" TextWrapping="Wrap" /></StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="#98A2AE" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <ItemsControl x:Name="MutualGroupsList" Visibility="Collapsed" Margin="40,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <Button Click="LoadFriendPosts_Click" Background="Transparent" BorderThickness="0" Padding="2,6" HorizontalContentAlignment="Stretch" UseSystemFocusVisuals="False">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#1684D7" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="B&#xE0;i &#x111;&#x103;ng" FontSize="16" Foreground="#17212B" />
                                    <TextBlock x:Name="FriendPostsStatus" Text="Ch&#x1EA1;m &#x111;&#x1EC3; xem b&#xE0;i &#x111;&#x103;ng" FontSize="12" Foreground="#7A8490" TextWrapping="Wrap" /></StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="#98A2AE" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <ItemsControl x:Name="FriendPostsList" Visibility="Collapsed" Margin="4,6,4,0">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="#F5F8FC" CornerRadius="10" Padding="10" Margin="0,4">
                                    <StackPanel><TextBlock Text="{Binding Text}" FontSize="14" Foreground="#273444" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#8793A0" Margin="0,5,0,0" /></StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ProfileFeedback" Text="Đang tải thông tin..." FontSize="12" Foreground="#718096"
                           TextWrapping="Wrap" Margin="4,12,4,8" />
                <Button Click="MessageButton_Click" Content="Nhắn tin" Style="{StaticResource ZaloRoundedActionButtonStyle}" Background="{StaticResource ZaloBlueBrush}" Foreground="White"
                        HorizontalAlignment="Stretch" Padding="14,10" BorderThickness="0"  UseSystemFocusVisuals="False" />
                <Button Click="RemoveFriendButton_Click" Content="H&#x1EE7;y k&#x1EBF;t b&#x1EA1;n" Style="{StaticResource ZaloRoundedActionButtonStyle}" Background="White" Foreground="#B42318" BorderBrush="#E5B7B4" BorderThickness="1" HorizontalAlignment="Stretch" Padding="14,9" Margin="0,8,0,0" UseSystemFocusVisuals="False" />
                <Button x:Name="BlockFriendButton" Click="BlockFriendButton_Click" Content="Chặn người dùng" Style="{StaticResource ZaloRoundedActionButtonStyle}"
                        Background="White" Foreground="#B42318" BorderBrush="#E5B7B4" BorderThickness="1"
                        HorizontalAlignment="Stretch" Padding="14,9" Margin="0,8,0,0"  UseSystemFocusVisuals="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
