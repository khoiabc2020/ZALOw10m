<Page
    x:Class="ZaloUWP.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZaloUWP.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource ZaloBlueBrush}" Height="56" Padding="4,0,16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="BackButton_Click" Style="{StaticResource FlatIconButtonStyle}" Foreground="White" Width="44" Height="44">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <TextBlock Text="Cài đặt" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <!-- Keep ScrollViewer defaults here: the attached scrollbar properties can
             trigger an IFrameworkElement7 cast on Windows 10 Mobile 1709. -->
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1">
            <StackPanel Padding="16">
                <!-- User Profile Card -->
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="60" Height="60" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="UserAvatarBrush" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameTextBlock" FontSize="17" FontWeight="Bold" />
                            <TextBlock x:Name="UserPhoneTextBlock" FontSize="13" Foreground="#666" Margin="0,2,0,0" />
                            <TextBlock x:Name="UserIdTextBlock" FontSize="11" Foreground="#999" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Wallpaper Picker Section -->
                <Border Background="White" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="HÌNH NỀN TRÒ CHUYỆN" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ZaloBlueBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="Chọn hình nền chính thức từ Zalo:" FontSize="13" Foreground="#666" Margin="0,0,0,8" />
                    <GridView x:Name="WallpaperGridView"
                              Height="140"
                              SelectionMode="Single"
                              SelectionChanged="WallpaperGridView_SelectionChanged"
                              >
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="1" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Width="82" Height="110" Background="#E5EBF2" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1" Margin="4">
                                    <Image Source="{Binding}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
                </Border>

                <!-- Preferences Section -->
                <Border Background="White" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="TÙY CHỌN ỨNG DỤNG" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ZaloBlueBrush}" Margin="0,0,0,8" />

                    <ComboBox x:Name="ThemeComboBox"
                              Header="Chế độ giao diện (hiện chỉ hỗ trợ sáng)"
                              SelectionChanged="ThemeComboBox_SelectionChanged"
                              HorizontalAlignment="Stretch" Margin="0,0,0,8" IsEnabled="False">
                        <ComboBoxItem Content="Giao diện sáng" />
                    </ComboBox>

                    <ToggleSwitch x:Name="SoundToggle"
                                  Header="Âm thanh thông báo và tin nhắn"
                                  Toggled="SoundToggle_Toggled"
                                  Margin="0,0,0,8" />

                    <ToggleSwitch x:Name="EnterSendToggle"
                                  Header="Nhấn Enter để gửi tin nhắn"
                                  Toggled="EnterSendToggle_Toggled" />
                </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="QUYỀN RIÊNG TƯ TÀI KHOẢN" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ZaloBlueBrush}" Margin="0,0,0,8" />
                    <ToggleSwitch x:Name="OnlineStatusToggle" Header="Hiển thị trạng thái truy cập" Toggled="PrivacyToggle_Toggled" Tag="show_online_status" Margin="0,0,0,4" IsEnabled="False" />
                    <ToggleSwitch x:Name="SeenStatusToggle" Header="Hiển thị trạng thái đã xem" Toggled="PrivacyToggle_Toggled" Tag="display_seen_status" Margin="0,0,0,4" IsEnabled="False" />
                    <ComboBox x:Name="BirthdayVisibilityCombo" Header="Hiển thị ngày sinh" SelectionChanged="PrivacyCombo_SelectionChanged" Tag="view_birthday" HorizontalAlignment="Stretch" Margin="0,0,0,4" IsEnabled="False">
                        <ComboBoxItem Content="Ẩn ngày sinh" />
                        <ComboBoxItem Content="Hiện đầy đủ ngày/tháng/năm" />
                        <ComboBoxItem Content="Chỉ hiện ngày và tháng" />
                    </ComboBox>
                    <ComboBox x:Name="ReceiveMessagesCombo" Header="Ai có thể nhắn tin cho bạn" SelectionChanged="PrivacyCombo_SelectionChanged" Tag="receive_message" HorizontalAlignment="Stretch" Margin="0,0,0,4" IsEnabled="False">
                        <ComboBoxItem Content="Mọi người" />
                        <ComboBoxItem Content="Chỉ bạn bè" />
                    </ComboBox>
                    <ComboBox x:Name="AcceptCallsCombo" Header="Ai có thể gọi cho bạn" SelectionChanged="PrivacyCombo_SelectionChanged" Tag="accept_stranger_call" HorizontalAlignment="Stretch" Margin="0,0,0,4" IsEnabled="False">
                        <ComboBoxItem Content="Chỉ bạn bè" />
                        <ComboBoxItem Content="Bạn bè và người đã liên hệ" />
                        <ComboBoxItem Content="Mọi người" />
                    </ComboBox>
                    <ToggleSwitch x:Name="AddByPhoneToggle" Header="Cho phép tìm bạn qua số điện thoại" Toggled="PrivacyToggle_Toggled" Tag="add_friend_via_phone" Margin="0,0,0,4" IsEnabled="False" />
                    <ToggleSwitch x:Name="AddByQrToggle" Header="Cho phép thêm bạn bằng mã QR" Toggled="PrivacyToggle_Toggled" Tag="add_friend_via_qr" Margin="0,0,0,4" IsEnabled="False" />
                    <ToggleSwitch x:Name="AddByGroupToggle" Header="Cho phép thêm bạn qua nhóm" Toggled="PrivacyToggle_Toggled" Tag="add_friend_via_group" Margin="0,0,0,4" IsEnabled="False" />
                    <ToggleSwitch x:Name="AddByContactToggle" Header="Cho phép thêm bạn từ danh bạ" Toggled="PrivacyToggle_Toggled" Tag="add_friend_via_contact" Margin="0,0,0,4" IsEnabled="False" />
                    <ToggleSwitch x:Name="RecommendProfileToggle" Header="Hiển thị tài khoản trong gợi ý kết bạn" Toggled="PrivacyToggle_Toggled" Tag="display_on_recommend_friend" IsEnabled="False" />
                    <TextBlock x:Name="PrivacyStatusText" Text="" FontSize="12" Foreground="#718096" TextWrapping="Wrap" Margin="2,6,2,0" />
                </StackPanel>
                </Border>

                <!-- Storage & Cache Section -->
                <Border x:Name="LocalDataSection" Background="White" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="DỮ LIỆU &amp; BỘ NHỚ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ZaloBlueBrush}" Margin="0,0,0,8" />
                    <Button Click="ClearCacheButton_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" HorizontalAlignment="Stretch" Padding="12" Background="#F2F5F8" UseSystemFocusVisuals="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Xóa bộ nhớ đệm (Cache)" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </Border>

                <!-- Logout Button -->
        <Button Click="LogoutButton_Click" Style="{StaticResource ZaloRoundedActionButtonStyle}" HorizontalAlignment="Stretch" Padding="12" Background="#FFF0F0" Foreground="#D32F2F" UseSystemFocusVisuals="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Đăng xuất tài khoản" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- App Info -->
                <StackPanel HorizontalAlignment="Center" Margin="0,16,0,16">
                    <TextBlock Text="Zalo cho Windows 10 Mobile" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="AboutVersionText" Text="" FontSize="11" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
